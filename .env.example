# Salin menjadi .env.local untuk mencoba di komputer sendiri (npm run dev).
# Di Vercel, isi nilai yang sama di Settings → Environment Variables.

# Opsional tapi disarankan: API key OpenAlex (gratis, kuota harian lebih besar). Dapatkan di https://openalex.org/settings/api
OPENALEX_API_KEY=

# AI — disarankan: satu key OpenRouter milik narasumber untuk semua peserta.
# Buat di https://openrouter.ai (menu Keys) dan isi kredit kecil di menu Credits.
OPENROUTER_API_KEY=
# Opsional: model OpenRouter lain. Bawaan: anthropic/claude-haiku-5.5
OPENROUTER_MODEL=
# Opsional: alamat situs Anda (dikirim sebagai HTTP-Referer ke OpenRouter)
APP_URL=

# Alternatif: key Google AI Studio (dipakai bila OPENROUTER_API_KEY kosong)
GEMINI_API_KEY=
# Opsional: paksa model tertentu. Jika kosong, aplikasi memilih model Gemini Flash terbaru secara otomatis.
GEMINI_MODEL=

# Alternatif penyedia format OpenAI lain (mis. Groq). Aktifkan dengan LLM_PROVIDER=openai
LLM_PROVIDER=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_MODEL=openai/gpt-oss-120b
OPENAI_COMPAT_LABEL=Groq

# Opsional: kode akses agar hanya peserta yang bisa memakai kuota Anda
ACCESS_CODE=
# Opsional: nama acara di kepala halaman
EVENT_NAME=AI-Assisted Research: Dari Ide hingga Publikasi

# Hanya untuk pengujian: 1 = pakai data contoh, tanpa memanggil OpenAlex/AI
MOCK=
