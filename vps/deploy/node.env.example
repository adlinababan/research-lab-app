# /etc/research-lab/node.env  (chmod 640, pemilik root:researchlab)
PORT=3311
HOST=127.0.0.1
# Sama persis dengan RL_INTERNAL_TOKEN di vps/ci4/.env
INTERNAL_TOKEN=GANTI_DENGAN_TOKEN_ACAK_64_KARAKTER

# Key server (opsional). Bila kosong, setiap pengguna mengisi key sendiri di aplikasi.
OPENROUTER_API_KEY=
OPENALEX_API_KEY=
# Batas waktu satu panggilan AI (ms)
AI_TIMEOUT_MS=110000
EVENT_NAME=AI-Assisted Research
