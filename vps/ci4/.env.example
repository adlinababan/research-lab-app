#--------------------------------------------------------------------
# Research Lab (VPS) — salin menjadi .env lalu sesuaikan.
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

app.baseURL = 'https://research-lab.example.ac.id/'
app.forceGlobalSecureRequests = true

# Cookie hanya lewat HTTPS
cookie.secure = true
cookie.samesite = Lax

# MySQL 8
database.default.hostname = 127.0.0.1
database.default.database = research_lab
database.default.username = research_lab
database.default.password = GANTI_PASSWORD_DB
database.default.DBDriver = MySQLi
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci
database.default.port = 3306

# Kunci enkripsi CodeIgniter (buat dengan: php spark key:generate)
encryption.key =

# Layanan Node internal (logika AI). Token harus sama dengan INTERNAL_TOKEN di /etc/research-lab/node.env
RL_NODE_URL = http://127.0.0.1:3311
RL_INTERNAL_TOKEN = GANTI_DENGAN_TOKEN_ACAK_64_KARAKTER
